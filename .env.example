# All optional. Missing keys only disable the related feature.
VITE_MAPTILER_KEY=
VITE_MAPILLARY_TOKEN=
VITE_TOMTOM_KEY=

# Google sign-in. Lovable Cloud issues this client id for the project's
# authorised origins; it is public by design and safe in the browser bundle.
VITE_GOOGLE_CLIENT_ID=

# OPENROUTER_API_KEY is a backend secret on purpose and is deliberately NOT
# listed here. Add it through Lovable's secure secrets form so it is stored as
# an encrypted server-side secret. The server function reads it from process.env
# and it never reaches the browser.
